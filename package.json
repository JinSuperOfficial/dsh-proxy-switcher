{
  "name": "dsh-proxy-switcher",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Hot-switch the outbound proxy of a running DeepSeek Harness (dsh): direct / system-env / custom proxy, multiple saved proxies, switchable from the dsh settings page with no restart.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis",
    "proxy",
    "socks5",
    "hot-switch"
  ],
  "license": "MIT",
  "author": "JinSuperOfficial",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinSuperOfficial/dsh-proxy-switcher.git"
  },
  "homepage": "https://github.com/JinSuperOfficial/dsh-proxy-switcher#readme",
  "bugs": {
    "url": "https://github.com/JinSuperOfficial/dsh-proxy-switcher/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-http-proxy": "^0.2.0-rc.1",
    "undici": ">=7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-http-proxy": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  },
  "scripts": {
    "test": "pwsh -NoProfile -File test/run-tests.ps1"
  }
}
